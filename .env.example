# Runtime
NODE_ENV=development
# Docker Compose host ports and local database password.
DAYFLOW_WEB_PORT=3002
DAYFLOW_API_PORT=3001
DAYFLOW_DB_PORT=5433
DAYFLOW_DB_PASSWORD=postgres
# Comma-separated exact origins in production. Development also permits HTTP loopback ports.
WEB_ORIGIN=http://localhost:3002
WEB_APP_URL=http://localhost:3002
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001/v1

# Neon/PostgreSQL
# Use the pooled Neon URL at runtime.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/dayflow
# Use the direct Neon URL only for controlled migrations.
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/dayflow

# Authentication
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
DATA_ENCRYPTION_KEY=replace-with-a-separate-32-character-or-longer-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# Object storage
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=dayflow-development
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
FILE_SCANNER_WEBHOOK_SECRET=replace-with-a-dedicated-scanner-secret

# Transactional email
EMAIL_PROVIDER=console
# Set EMAIL_PROVIDER=gmail-oauth2 and provide all values below for inbox delivery.
EMAIL_FROM=Dayflow <your-account@gmail.com>
GMAIL_SENDER_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
