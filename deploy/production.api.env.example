NODE_ENV=production
API_PORT=3001
WEB_ORIGIN=https://dayflow.example
WEB_APP_URL=https://dayflow.example
DATABASE_URL=postgresql://USER:PASSWORD@POOLED_NEON_HOST/DB?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_NEON_HOST/DB?sslmode=require
JWT_ACCESS_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
JWT_REFRESH_SECRET=GENERATE_A_DIFFERENT_RANDOM_SECRET
DATA_ENCRYPTION_KEY=GENERATE_A_SEPARATE_RANDOM_SECRET
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=true
OBJECT_STORAGE_ENDPOINT=https://OBJECT_STORAGE_ENDPOINT
OBJECT_STORAGE_REGION=REGION
OBJECT_STORAGE_BUCKET=PRIVATE_BUCKET
OBJECT_STORAGE_ACCESS_KEY_ID=SECRET_MANAGER_REFERENCE
OBJECT_STORAGE_SECRET_ACCESS_KEY=SECRET_MANAGER_REFERENCE
FILE_SCANNER_WEBHOOK_SECRET=GENERATE_A_DEDICATED_RANDOM_SECRET
EMAIL_FROM=Dayflow <YOUR_GOOGLE_WORKSPACE_ACCOUNT>
EMAIL_PROVIDER=gmail-oauth2
GMAIL_SENDER_EMAIL=YOUR_GOOGLE_WORKSPACE_ACCOUNT
GOOGLE_CLIENT_ID=SECRET_MANAGER_REFERENCE
GOOGLE_CLIENT_SECRET=SECRET_MANAGER_REFERENCE
GOOGLE_REFRESH_TOKEN=SECRET_MANAGER_REFERENCE
